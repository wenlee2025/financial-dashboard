# ========================================================
# 環境變數與 GitHub Secrets 設定範本 (.env.example)
# ========================================================

# 1. AI 引擎金鑰 (任選一種，預設推薦免費且額度充足的 Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. 專業數據源 (選填，無填寫時系統自動降級為免 Key 公開數據源)
FINMIND_API_TOKEN=your_finmind_token_here
FINNHUB_API_KEY=your_finnhub_key_here
FRED_API_KEY=your_fred_api_key_here

# 3. 通訊軟體推播設定 (有填寫的通道會自動觸發推播)
# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# LINE Messaging API (Bot)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_USER_ID=your_line_user_id_or_group_id

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# 4. SMTP 郵件發送設定 (若需發送每日 HTML 電子報)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_TO=recipient1@example.com,recipient2@example.com
EMAIL_FROM=your_email@gmail.com

# 5. GitHub Pages 網址 (用於推播訊息中的卡片查看連結)
DASHBOARD_URL=https://yourusername.github.io/financial-dashboard/
